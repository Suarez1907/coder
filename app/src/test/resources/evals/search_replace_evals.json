      "search": "    val a = 1",
      "replace": "    val a = 2",
      "expect": "ok",
      "contains": "val a = 2"
    },
    {
      "id": "indent_tier2",
      "content": "fun main() {\n    val a = 1\n    println(a)\n}\n",
